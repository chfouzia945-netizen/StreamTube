NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host:5432/streamtube
DATABASE_SSL=true
# Optional absolute FFmpeg binary path. Defaults to ffmpeg in PATH.
FFMPEG_PATH=ffmpeg
# Phase 4 infrastructure placeholders:
# S3_ENDPOINT=
# S3_BUCKET=streamtube-media
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# STRIPE_SECRET_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
